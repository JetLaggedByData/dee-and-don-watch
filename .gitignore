.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw SEPA caches - built by fetch.py, restored in CI from actions/cache (or
# the data-seed release), never committed.
data/

# Derived site data. NOT committed: the pipeline regenerates it on every CI run
# and upload-pages-artifact packages it straight from the runner. Committing it
# every 30 minutes would add ~17,500 churn commits a year.
# After cloning, run the pipeline once before previewing locally.
site/data/
